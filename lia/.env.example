# ---- Claude (obrigatório) ----
ANTHROPIC_API_KEY=
# Modelo e esforço. "low" deixa a conversa rápida e barata.
LIA_MODEL=claude-opus-5-5
LIA_EFFORT=low

# ---- WhatsApp Cloud API (Meta) ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Uma senha que você inventa e cola também no painel da Meta, em Webhooks.
WHATSAPP_VERIFY_TOKEN=
# Chave secreta do app (Meta > Configurações do app > Básico). Confere que a mensagem veio da Meta.
WHATSAPP_APP_SECRET=
GRAPH_API_VERSION=v23.0

# ---- Você (operador) ----
# Seu número pessoal, só dígitos com DDI e DDD (ex.: 5581999998888). Comandos /ajuda chegam por ele.
ADMIN_PHONE=
# Senha do simulador em /sim. Mínimo 24 caracteres. Gere com: openssl rand -hex 24
# Sem ela, o simulador só abre no próprio computador (localhost).
ADMIN_TOKEN=
# Contato mostrado para quem ainda não é cliente.
SALES_CONTACT=Fala com a gente pelo Instagram @suaagencia

# ---- Transcrição de áudio (opcional) ----
# Qualquer serviço compatível com /v1/audio/transcriptions (formato Whisper).
TRANSCRIBE_API_URL=
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=whisper-1

# ---- Recorte do fundo das fotos (opcional, recomendado) ----
# Deixa o produto "solto" na frente do título, como nas artes profissionais. Sem isso, a foto entra emoldurada.
# remove.bg:  CUTOUT_API_URL=https://api.remove.bg/v1.0/removebg   CUTOUT_API_KEY_HEADER=X-Api-Key
# Photoroom:  CUTOUT_API_URL=https://sdk.photoroom.com/v1/segment   CUTOUT_API_KEY_HEADER=x-api-key
CUTOUT_API_URL=
CUTOUT_API_KEY=
CUTOUT_API_KEY_HEADER=X-Api-Key

# ---- Segurança ----
# Proxies na frente do servidor (Railway/Render/Cloudflare = 1; Node recebendo direto = 0).
TRUST_PROXY=1
# Limites contra spam por cliente (cada conversa com a IA custa dinheiro).
LIMIT_MESSAGES_10MIN=30
LIMIT_AI_TURNS_DAY=150

PORT=3000
DATA_DIR=./data
